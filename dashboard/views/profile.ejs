<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil: <%= player.name %> | Yukinotempe RPG</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #0b0f19;
            --surface-card: rgba(15, 23, 42, 0.78);
            --surface-inner: rgba(30, 41, 59, 0.65);
            --surface-elevated: rgba(51, 65, 85, 0.55);
            --border-subtle: rgba(148, 163, 184, 0.15);
            --border-focus: rgba(139, 92, 246, 0.5);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --accent-purple: #8b5cf6;
            --accent-emerald: #10b981;
            --accent-amber: #f59e0b;
            --accent-sky: #0284c7;
            --danger: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            <% if (bgUrl) { %>
                background-image: url('<%= bgUrl %>');
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                background-repeat: no-repeat;
            <% } else { %>
                background-color: var(--bg-base);
            <% } %>
            color: var(--text-primary);
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 24px 16px;
            position: relative;
        }

        /* Ambient dark backdrop overlay agar wallpaper tetap terlihat jelas namun teks super legible */
        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(11, 15, 25, 0.55);
            z-index: 0;
            pointer-events: none;
        }

        .main-container {
            width: 100%;
            max-width: 480px;
            position: relative;
            z-index: 1;
        }

        /* Card Container Modern (Frosted Glass Clean) */
        .card {
            background-color: var(--surface-card);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-subtle);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.65), 0 0 1px 1px var(--border-subtle);
        }

        /* Banner Header Menggunakan Background Karakter Penuh */
        .banner-header {
            position: relative;
            height: 170px;
            width: 100%;
            overflow: hidden;
            border-bottom: 1px solid var(--border-subtle);
            <% if (bgUrl) { %>
                background-image: url('<%= bgUrl %>');
                background-size: cover;
                background-position: center;
            <% } else { %>
                background-color: #1e293b;
            <% } %>
        }

        /* Subtle dark scrim di bawah header agar transisi ke body card seamless */
        .banner-scrim {
            position: absolute;
            inset: 0;
            background-color: rgba(15, 23, 42, 0.25);
        }

        .banner-badge {
            position: absolute;
            top: 14px;
            right: 14px;
            background-color: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(8px);
            border: 1px solid var(--border-subtle);
            color: #e2e8f0;
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 20px;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .badge-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: var(--accent-emerald);
        }

        /* Profile Body */
        .card-body {
            padding: 0 24px 28px 24px;
            position: relative;
        }

        /* Avatar Container Floating */
        .avatar-wrap {
            margin-top: -46px;
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .avatar {
            width: 92px;
            height: 92px;
            border-radius: 22px;
            background-color: #1e293b;
            border: 4px solid #0f172a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            font-weight: 800;
            color: var(--accent-purple);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.35);
            font-family: 'JetBrains Mono', monospace;
        }

        .level-pill {
            background-color: var(--surface-inner);
            border: 1px solid var(--border-subtle);
            padding: 6px 14px;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            margin-bottom: 6px;
        }

        .level-pill-label {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            font-weight: 700;
        }

        .level-pill-val {
            font-size: 16px;
            font-weight: 800;
            color: var(--accent-emerald);
            font-family: 'JetBrains Mono', monospace;
        }

        /* Identity Block */
        .identity {
            margin-bottom: 22px;
        }

        .player-name {
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.3px;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .player-role {
            font-size: 13px;
            color: var(--text-secondary);
            font-weight: 500;
            margin-top: 2px;
        }

        /* Stats Grid Modern */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .stat-card {
            background-color: var(--surface-inner);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            transition: border-color 0.2s ease;
        }

        .stat-card:hover {
            border-color: var(--border-focus);
        }

        .stat-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .stat-title {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--text-muted);
        }

        .stat-icon {
            font-size: 14px;
        }

        .stat-number {
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            font-family: 'JetBrains Mono', monospace;
        }

        .color-gold { color: var(--accent-amber); }
        .color-bank { color: #38bdf8; }
        .color-status {
            font-size: 13px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        /* Progress Exp Section */
        .progress-box {
            background-color: var(--surface-inner);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            padding: 14px 16px;
            margin-bottom: 22px;
        }

        .progress-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            margin-bottom: 8px;
        }

        .progress-label {
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 11px;
        }

        .progress-percent {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
            color: var(--accent-emerald);
        }

        .track {
            height: 8px;
            background-color: rgba(15, 23, 42, 0.85);
            border-radius: 99px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .fill {
            height: 100%;
            background-color: var(--accent-emerald);
            border-radius: 99px;
            width: <%= Math.min(((player.exp || 0) / ((player.level || 1) * 100)) * 100, 100) %>%;
        }

        .progress-numbers {
            display: flex;
            justify-content: space-between;
            margin-top: 6px;
            font-size: 11px;
            color: var(--text-muted);
            font-family: 'JetBrains Mono', monospace;
        }

        /* Inventory Sections */
        .inv-category-group {
            margin-bottom: 18px;
        }

        .category-header {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--text-secondary);
            margin-bottom: 8px;
            padding-bottom: 4px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .category-count {
            background-color: var(--surface-elevated);
            color: var(--text-muted);
            font-size: 10px;
            padding: 1px 6px;
            border-radius: 4px;
            font-family: 'JetBrains Mono', monospace;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 14px;
        }

        .section-title {
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .badge-count {
            background-color: var(--surface-elevated);
            color: var(--text-secondary);
            font-size: 11px;
            padding: 2px 7px;
            border-radius: 6px;
            font-family: 'JetBrains Mono', monospace;
        }

        .chips-container {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 6px;
        }

        .item-chip {
            background-color: var(--surface-inner);
            border: 1px solid var(--border-subtle);
            border-radius: 10px;
            padding: 6px 10px;
            font-size: 12px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: #e2e8f0;
            transition: all 0.15s ease;
        }

        .item-chip:hover {
            border-color: rgba(255, 255, 255, 0.25);
            background-color: var(--surface-elevated);
        }

        .chip-qty {
            background-color: rgba(139, 92, 246, 0.2);
            color: #c4b5fd;
            border: 1px solid rgba(139, 92, 246, 0.3);
            padding: 1px 6px;
            border-radius: 6px;
            font-size: 11px;
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700;
        }

        .empty-inv {
            color: var(--text-muted);
            font-size: 13px;
            font-style: italic;
            padding: 10px 0;
        }

        /* Pet Card Specific */
        .pet-card {
            background-color: var(--surface-inner);
            border: 1px solid var(--border-subtle);
            border-radius: 16px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        .pet-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .pet-avatar {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background-color: rgba(245, 158, 11, 0.15);
            border: 1px solid rgba(245, 158, 11, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .pet-name {
            font-weight: 700;
            font-size: 14px;
            color: #ffffff;
        }

        .pet-type {
            font-size: 12px;
            color: var(--text-muted);
        }

        .pet-level {
            background-color: rgba(245, 158, 11, 0.15);
            color: var(--accent-amber);
            border: 1px solid rgba(245, 158, 11, 0.3);
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            font-family: 'JetBrains Mono', monospace;
        }

        /* Clean Footer */
        .card-footer {
            text-align: center;
            font-size: 11px;
            color: var(--text-muted);
            border-top: 1px solid var(--border-subtle);
            padding-top: 18px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .footer-brand {
            font-weight: 600;
            color: var(--text-secondary);
        }
    </style>
</head>
<body>

    <div class="main-container">
        <div class="card">
            <!-- Full Background Character Header Banner -->
            <div class="banner-header">
                <div class="banner-scrim"></div>
                <div class="banner-badge">
                    <span class="badge-dot"></span>
                    YUKINOTEMPE
                </div>
            </div>

            <!-- Profile Content Body -->
            <div class="card-body">
                <!-- Avatar & Level Floating -->
                <div class="avatar-wrap">
                    <div class="avatar">
                        <%= player.name.charAt(0).toUpperCase() %>
                    </div>
                    <div class="level-pill">
                        <span class="level-pill-label">Player Level</span>
                        <span class="level-pill-val">Lv. <%= player.level || 1 %></span>
                    </div>
                </div>

                <!-- Identity -->
                <div class="identity">
                    <h1 class="player-name"><%= player.name %></h1>
                    <div class="player-role">Petualang RPG • Aktif</div>
                </div>

                <!-- Modern Clean Stats Grid (No Gradient) -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-meta">
                            <span class="stat-title">Gold (Dompet)</span>
                            <span class="stat-icon">🪙</span>
                        </div>
                        <div class="stat-number color-gold"><%= (player.money || 0).toLocaleString('id-ID') %> G</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-meta">
                            <span class="stat-title">Bank Simpanan</span>
                            <span class="stat-icon">🏦</span>
                        </div>
                        <div class="stat-number color-bank"><%= (player.bank || 0).toLocaleString('id-ID') %> G</div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-meta">
                            <span class="stat-title">Status Akun</span>
                            <span class="stat-icon">🛡️</span>
                        </div>
                        <div class="color-status" style="color: <%= player.isBanned ? 'var(--danger)' : 'var(--accent-emerald)' %>;">
                            <%= player.isBanned ? 'BANNED' : 'Verified (Aman)' %>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-meta">
                            <span class="stat-title">Karakter Latar</span>
                            <span class="stat-icon">🖼️</span>
                        </div>
                        <div class="stat-number" style="font-size: 13px; color: #cbd5e1;">
                            <%= (player.inventory && player.inventory.active_background) ? player.inventory.active_background : 'Default' %>
                        </div>
                    </div>
                </div>

                <!-- Progress Section Clean -->
                <div class="progress-box">
                    <div class="progress-header">
                        <span class="progress-label">Experience Progress</span>
                        <% 
                           const currentExp = player.exp || 0;
                           const targetExp = (player.level || 1) * 100;
                           const expPct = Math.min(Math.round((currentExp / targetExp) * 100), 100);
                        %>
                        <span class="progress-percent"><%= expPct %>%</span>
                    </div>
                    <div class="track">
                        <div class="fill"></div>
                    </div>
                    <div class="progress-numbers">
                        <span><%= currentExp.toLocaleString('id-ID') %> EXP</span>
                        <span><%= targetExp.toLocaleString('id-ID') %> EXP Target</span>
                    </div>
                </div>

                <!-- Inventory Section Grouped by Category -->
                <% 
                   const inv = player.inventory || {};
                   // Daftar kunci internal/sistem yang tidak boleh ditampilkan ke publik
                   const internalKeys = [
                       'farm', 'farms', 'farmLevel', 'limit', 'pet', 'pets', 'activePet',
                       'active_background', 'active_background_image',
                       'fishIndex', 'petIndex', 'stamina', 'lastStaminaRegen',
                       'lastAdventure', 'lastBattle', 'lastBankInterest',
                       'buffActive', 'buffCharges', 'job', 'jobExp', 'jobLevel'
                   ];

                   // Daftar nama karakter gacha
                   const characterCards = [
                       'Kazuha', 'Furina', 'Raiden Shogun', 'Kamisato Ayato', 'Tartaglia',
                       'Vestia Zeta', 'Sakura', 'Mythia Batford', 'Gwar Gura', 'Monkey D. Luffy',
                       'Nephie Phelia'
                   ];

                   // Pengelompokan Kategori
                   const categories = {
                       equipment: { title: "🛠️ Perlengkapan & Alat Pancing", items: [] },
                       cards: { title: "🎴 Kartu Karakter & Koleksi", items: [] },
                       farming: { title: "🌱 Pertanian & Perkebunan", items: [] },
                       catches: { title: "🐠 Hasil Tangkapan & Memancing", items: [] },
                       consumables: { title: "🧪 Potion & Consumables", items: [] },
                       others: { title: "📦 Barang Petualangan Lainnya", items: [] }
                   };

                   let totalItemTypes = 0;

                   Object.keys(inv).forEach(item => {
                       if (internalKeys.includes(item)) return;
                       const qty = inv[item];
                       if (typeof qty !== 'number' || qty <= 0) return;

                       totalItemTypes++;
                       const itemLower = item.toLowerCase();

                       if (item.includes("Rod") || item.includes("Net") || item.includes("Lure")) {
                           categories.equipment.items.push(item);
                       } else if (characterCards.includes(item)) {
                           categories.cards.items.push(item);
                       } else if (item.startsWith("Bibit") || itemLower === "gandum" || itemLower === "wortel segar" || itemLower === "melon manis" || itemLower === "anggur sultan" || itemLower === "buah bintang jatuh") {
                           categories.farming.items.push(item);
                       } else if (
                           item.startsWith("Ikan ") || item.startsWith("Belut ") || item.startsWith("Hiu ") ||
                           ["sepatu bekas", "kaleng kosong", "botol kaca", "ranting kayu", "plastik kresek", "ban bekas", "kaos kaki bolong", "bungkus mi instan", "udang galah", "lobster", "kepiting kecil", "cumi-cumi", "gurita raksasa", "kecebong", "leviathan scale", "harta karun bajak laut", "kraken raksasa", "penyu raksasa", "naga air tawar"].includes(itemLower)
                       ) {
                           categories.catches.items.push(item);
                       } else if (["potion", "buff scroll", "exp book", "gold coin", "mie ayam", "mystery pet box", "kartu ganti nama"].includes(itemLower)) {
                           categories.consumables.items.push(item);
                       } else {
                           categories.others.items.push(item);
                       }
                   });

                   // Sort masing-masing kategori A-Z
                   Object.values(categories).forEach(cat => cat.items.sort());
                %>
                
                <div class="section-header">
                    <div class="section-title">
                        🎒 Tas & Perlengkapan
                    </div>
                    <span class="badge-count"><%= totalItemTypes %> Jenis Item</span>
                </div>

                <% if (totalItemTypes === 0) { %>
                    <div class="empty-inv">Tas masih kosong... Belum ada barang petualangan.</div>
                <% } else { %>
                    <% Object.entries(categories).forEach(([catKey, cat]) => { %>
                        <% if (cat.items.length > 0) { %>
                            <div class="inv-category-group">
                                <div class="category-header">
                                    <span><%= cat.title %></span>
                                    <span class="category-count"><%= cat.items.length %></span>
                                </div>
                                <div class="chips-container">
                                    <% cat.items.forEach(item => { %>
                                        <div class="item-chip">
                                            <span><%= item %></span>
                                            <span class="chip-qty"><%= inv[item] %>x</span>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% } %>
                    <% }) %>
                <% } %>

                <!-- Pet Section -->
                <% if (player.inventory && player.inventory.pet) { %>
                <div class="section-header">
                    <div class="section-title">
                        🐾 Companion Peliharaan
                    </div>
                </div>
                <div class="pet-card">
                    <div class="pet-info">
                        <div class="pet-avatar">🦊</div>
                        <div>
                            <div class="pet-name"><%= player.inventory.pet.type.toUpperCase() %></div>
                            <div class="pet-type">Active Adventure Companion</div>
                        </div>
                    </div>
                    <div class="pet-level">Lv. <%= player.inventory.pet.level %></div>
                </div>
                <% } %>

                <!-- Footer Clean -->
                <div class="card-footer">
                    <span class="footer-brand">Yukinotempe Cloud RPG Network</span>
                    <span>© 2026 Zeta Development • Real-Time Live Server</span>
                </div>
            </div>
        </div>
    </div>

</body>
</html>